# Copy this file to .env.local and fill in your values.
# Without these, the app runs in local mode (data stored in browser storage).
#
# Find these in your Supabase dashboard:
#   Project Settings → API Keys → Project URL / Publishable Key

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# The Publishable Key (formerly "anon key") is safe to expose in the frontend —
# security comes from Row Level Security, not secrecy.
# Never put the Service Role Key in the frontend.
