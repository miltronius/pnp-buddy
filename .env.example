# Kopie als .env.local anlegen und ausfüllen.
# Ohne diese Werte startet die App im lokalen Modus (Daten im Browser-Storage).
# Zu finden im Supabase-Dashboard unter: Project Settings → API Keys
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=dein-publishable-key

# Der Publishable Key (früher "anon key") ist öffentlich — die Sicherheit
# kommt aus Row Level Security, nicht aus Geheimhaltung.
# Der Service-Role-Key gehört NIEMALS ins Frontend.
